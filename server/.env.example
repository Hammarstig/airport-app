# Gatelog server - miljövariabler (läses endast i server/src/config.js)
# Kopiera till .env eller sätt i din process manager. Inget här krävs i utveckling.

# development | production | test
NODE_ENV=development
PORT=8787

# Krävs i produktion (minst 32 tecken), annars startar inte servern. Generera t.ex. med:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Sökvägar (default: server/data/gatelog.db, server/data/uploads, client/dist)
DB_PATH=
UPLOAD_DIR=
STATIC_DIR=

# Bakom reverse proxy: antal proxyhopp (1), true/false eller adresser enligt Express trust proxy
# (krävs för rätt IP i rate limit och säkerhetslogg; varning i produktion om den saknas bakom proxy)
TRUST_PROXY=
# Tillåten origin för CORS i produktion (utveckling tillåter localhost:5173)
CORS_ORIGIN=

# Rate limit för /api/auth (per IP)
AUTH_RATE_MAX=100
AUTH_RATE_WINDOW_MS=900000
# Totalt antal skrivande anrop per användare/IP och 15 min. Specifika gränser: check-ins 60/h,
# foton 20/h, kommentarer 60/h, följningar 100/h, gilla 300/h, loungerecensioner 30/h,
# importer 5/dygn, förhandsvisning av import 30/h, sök och topplistor 300/5 min.
WRITE_RATE_MAX=300
# Multiplicerar alla skrivgränser (default 1, i NODE_ENV=test 1000)
WRITE_RATE_SCALE=

# Cache för topplistor per vecka/månad/år i ms (default 30000, 0 i test)
RANKING_CACHE_MS=
# JSON-loggrad per anrop (default på utom i test)
LOG_REQUESTS=
# Säkerhetslogg (log: security) för inloggning, sessioner, lösenord, radering, moderering och 429
# (default på utom i test). Rekommenderad lagringstid hos loggmottagaren: 90 dagar.
SECURITY_LOG=

# Moderatorer sätts i databasen (users.role), inte här (SEC-03):
#   npm run moderator -w server -- grant <användarnamn> | revoke <användarnamn> | list
# Web Push (VAPID). Generera med: npx web-push generate-vapid-keys
# Saknas de genereras nycklar i utveckling till server/data/vapid.json; i produktion är push då avstängt.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Skyddade standardval för nya konton (default 1 h fördröjning och dold hemmaflygplats; i test 0/av)
NEW_ACCOUNT_PUBLISH_DELAY_HOURS=
NEW_ACCOUNT_HIDE_HOME=
# Misslyckade inloggningar per 15 min: per konto+IP hård gräns (default 10). Per konto ger 50 fel
# växande fördröjning (250 ms per fel, max 5 s) och först 1000 fel hård spärr, aldrig för känd enhet.
LOGIN_FAIL_MAX=
LOGIN_FAIL_ACCOUNT_MAX=
LOGIN_FAIL_ACCOUNT_HARD_MAX=
# Publik bas-URL för Open Graph-taggar, t.ex. https://gatelog.se. I produktion används aldrig
# Host-headern; utan PUBLIC_URL blir länkarna relativa (SEC-21).
PUBLIC_URL=
# Extra tillåtna push-tjänster utöver FCM, Mozilla, Windows och Apple (kommaseparerade värdar)
PUSH_EXTRA_HOSTS=

# Sopare (publicering av fördröjda check-ins i statistiken och gallring), intervall i ms
SWEEP_MS=
# Gallring i dagar: utgångna/återkallade sessioner, modereringslogg, avslutade rapporter
RETAIN_SESSIONS_DAYS=30
RETAIN_MODERATION_DAYS=365
RETAIN_REPORTS_DAYS=365

# Beständig datakatalog för databas, uppladdningar och VAPID-nycklar (Railway sätter RAILWAY_VOLUME_MOUNT_PATH automatiskt)
# DATA_DIR=/data
# VAPID_FILE=/data/vapid.json
