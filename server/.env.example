# Gatelog server - miljövariabler (läses endast i server/src/config.js)
# Kopiera till .env eller sätt i din process manager. Inget här krävs i utveckling.

# development | production | test
NODE_ENV=development
PORT=8787

# Krävs i produktion (minst 32 tecken), annars startar inte servern. Generera t.ex. med:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Sökvägar (default: server/data/gatelog.db, server/data/uploads, client/dist)
DB_PATH=
UPLOAD_DIR=
STATIC_DIR=

# Bakom reverse proxy: antal proxyhopp eller Express trust proxy-värde (krävs för rätt IP i rate limit)
TRUST_PROXY=
# Tillåten origin för CORS i produktion (utveckling tillåter localhost:5173)
CORS_ORIGIN=

# Rate limit för /api/auth (per IP)
AUTH_RATE_MAX=100
AUTH_RATE_WINDOW_MS=900000
# Totalt antal skrivande anrop per användare/IP och 15 min. Specifika gränser: check-ins 60/h,
# foton 20/h, kommentarer 60/h, följningar 100/h, gilla 300/h, loungerecensioner 30/h.
WRITE_RATE_MAX=300
# Multiplicerar alla skrivgränser (default 1, i NODE_ENV=test 1000)
WRITE_RATE_SCALE=

# Cache för topplistor per vecka/månad/år i ms (default 30000, 0 i test)
RANKING_CACHE_MS=
# JSON-loggrad per anrop (default på utom i test)
LOG_REQUESTS=

# Moderatorer (användarnamn, kommaseparerade) som får hantera rapporter
MODERATORS=
# Web Push (VAPID). Generera med: npx web-push generate-vapid-keys
# Saknas de genereras nycklar i utveckling till server/data/vapid.json; i produktion är push då avstängt.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Skyddade standardval för nya konton (default 1 h fördröjning och dold hemmaflygplats; i test 0/av)
NEW_ACCOUNT_PUBLISH_DELAY_HOURS=
NEW_ACCOUNT_HIDE_HOME=
# Misslyckade inloggningar per 15 min: per konto+IP (default 10) och per konto (default 50)
LOGIN_FAIL_MAX=
LOGIN_FAIL_ACCOUNT_MAX=
# Publik bas-URL för Open Graph-taggar, t.ex. https://gatelog.se
PUBLIC_URL=
